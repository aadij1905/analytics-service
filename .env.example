PORT=4000

# This service's own externally-reachable base URL. Only used when R2 isn't
# configured below (local-disk screenshot fallback) — points crawler-saved
# screenshots at this service's own /screenshots static route.
PUBLIC_URL=http://localhost:4000

# Cloudflare R2 (S3-compatible) screenshot storage. All five must be set for
# R2 to be used — if any are missing, the crawler falls back to writing
# screenshots to local disk (see PUBLIC_URL above). Local disk is fine for
# dev; use R2 in production (Railway's filesystem is ephemeral and its
# volumes are small — see crawler/screenshotStorage.js for details).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
